class_name DrawLayer
extends Node2D
# لوحة رسم فرعية تحت عقدة اللعبة (14 — الأداء).
#
# الخريطة (الأرض والمباني) لا تتغير بين إطار وإطار، ورسمها من GDScript في كل
# إطار كان يستهلك وحده أكثر من 20 مللي ثانية. الآن تُرسم مرة واحدة في لوحاتها،
# ويحتفظ Godot بأوامر رسمها، فلا يُعاد تنفيذ شيء إلا عند تغيّر فعلي (استيلاء
# أو خريطة جديدة). الوحدات والمقذوفات وحدها تُعاد في كل إطار.
#
# الترتيب المائل محفوظ كما كان: لكل قطر (i + j) لوحة مباني ثابتة تليها لوحة
# وحدات متحركة، فتظهر الوحدة خلف المبنى الذي أمامها وأمام الذي خلفها.

var game = null
var what := "ground"   # ground | fires | band | units | top
var band := 0

func _draw() -> void:
	if game != null:
		game.draw_layer(self, what, band)
