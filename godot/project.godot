; مشروع Godot 4.x — نموذج "مدينة العصابات"
; افتح هذا المجلد من Godot: Import ثم اختر project.godot

config_version=5

[application]

config/name="مدينة العصابات"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.09, 0.09, 0.1, 1)

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[gui]

theme/custom_font="res://fonts/NotoNaskhArabic.ttf"

[internationalization]

rendering/root_node_layout_direction=2

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
