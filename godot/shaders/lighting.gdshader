shader_type canvas_item;
render_mode blend_mix, unshaded;

// إضاءة المشهد — القسم 10.
//
// يحل محل مستطيل الطقس الذي كان يُرسم كامل الشاشة بلون واحد مسطّح، فلا يضيف
// تمريرة رسم جديدة: نفس المستطيل، نفس أمر الرسم الواحد، لكن بلون محسوب.
// بلا قراءة أي صورة (لا texture ولا SCREEN_TEXTURE): حساب فقط، وهو أرخص ما
// يمكن على معالجات الجوال الضعيفة حيث النطاق الترددي أغلى من الحساب.
//
// أثران فقط، وكلاهما تعتيم لا إضاءة، فيبقى المزج واحداً:
//   1. حفّ الأطراف (vignette): الأطراف أغمق قليلاً فتُجمع العين على وسط المعركة.
//   2. ظل الأرضية: أسفل الشاشة أغمق قليلاً من أعلاها، فيبدو المشهد مضاءً من فوق.

uniform vec4 tint : source_color = vec4(0.0, 0.0, 0.0, 0.0);  // لون الطقس وشفافيته
uniform float vignette = 0.30;      // أقصى تعتيم عند الركن
uniform float vignette_from = 0.55; // من أي نصف قطر يبدأ (0 = المركز، 0.7 = الركن)
uniform float floor_shade = 0.10;   // فرق الإضاءة بين أعلى الشاشة وأسفلها
uniform float aspect = 1.15;        // تصحيح نسبة الشاشة حتى تكون الحفّة بيضاوية

void fragment() {
	vec2 d = SCREEN_UV - vec2(0.5);
	float r = length(d * vec2(aspect, 1.0));
	// تعتيم الأطراف + تعتيم الأسفل، كلاهما شفافية سوداء
	float dark = smoothstep(vignette_from, 0.78, r) * vignette
		+ SCREEN_UV.y * floor_shade;

	// دمج لون الطقس مع التعتيم في تمريرة مزج واحدة.
	// المطلوب أن تكون النتيجة كأننا رسمنا الطقس ثم السواد فوقه:
	//   (1 - a) = (1 - tint.a) * (1 - dark)
	float a = tint.a + dark - tint.a * dark;
	vec3 c = a > 0.0001 ? (tint.rgb * tint.a * (1.0 - dark)) / a : vec3(0.0);
	COLOR = vec4(c, a);
}
